{
  "apiVersion": "silo-standard/v0",
  "metadata": {
    "id": "executions",
    "version": "0.1.3",
    "name": "Executions",
    "description": "For users of the superpowers plugin: when an agent carries out a written plan step by step, each run shows on the task it carries out, with its steps. Silos reads the plugin's progress journal (.superpowers/sdd/<plan>/progress.md) and hangs each run from the task whose conversation wrote it, or whose `source` names the same plan. The kernel writes them; nobody writes into this silo."
  },
  "spec": {
    "producer": { "role": "kernel" },
    "sources": [
      { "id": "executions", "type": "kernel", "root": "kernel", "kind": "execution" }
    ],
    "kinds": {
      "execution": {
        "envelope": {
          "id": { "field": "id" },
          "identity": { "template": "{{title}}" },
          "state": { "field": "state" },
          "at": { "field": "updatedAt" },
          "anchors": [{ "hub": "task", "from": "parent" }],
          "updatedBy": { "field": "updatedBy", "values": ["kernel"] }
        },
        "states": [
          { "value": "running", "label": { "one": "running", "many": "running" } },
          { "value": "fixing", "label": { "one": "fixing", "many": "fixing" } },
          { "value": "stopped", "label": { "one": "stopped", "many": "stopped" } },
          { "value": "done", "label": { "one": "done", "many": "done" }, "terminal": true }
        ],
        "fields": {
          "title": { "type": "string", "required": true },
          "updatedAt": { "type": "timestamp", "required": true },
          "done": { "type": "number", "required": true },
          "total": { "type": "number", "required": true },
          "totalFrom": { "type": "string", "required": true },
          "gone": { "type": "boolean", "required": true },
          "ledger": { "type": "string", "required": true },
          "session": { "type": "string", "optional": true },
          "folder": { "type": "string", "optional": true },
          "agent": { "type": "string", "optional": true },
          "project": { "type": "string", "optional": true },
          "doc": { "type": "string", "optional": true },
          "fixingTask": { "type": "number", "optional": true },
          "round": { "type": "number", "optional": true },
          "task": { "type": "string", "optional": true },
          "taskRef": { "type": "string", "optional": true },
          "edge": { "type": "string", "optional": true },
          "otherLedgers": { "type": "number", "optional": true },
          "otherLedgersSay": { "type": "string", "optional": true }
        },
        "unknownFields": "preserve",
        "examples": [
          {
            "id": "-home-op-shop~6ad8e4db-0000-4000-8000-000000000001",
            "title": "Stripe checkout", "updatedAt": "2026-11-03T09:40:00.000Z",
            "done": 3, "total": 7, "totalFrom": "document", "gone": false,
            "ledger": "/home/op/shop/.worktrees/checkout/.superpowers/sdd/checkout/progress.md",
            "session": "6ad8e4db-0000-4000-8000-000000000001", "folder": "-home-op-shop", "agent": "writer",
            "project": "/home/op/shop", "doc": "docs/plans/checkout.md",
            "fixingTask": 4, "round": 1,
            "task": "folder:/home/op/shop/launch/tasks/t3", "taskRef": "launch#t3", "edge": "conversation",
            "state": "fixing", "updatedBy": "kernel"
          },
          {
            "id": "ledger~-home-op-shop--superpowers-sdd-shipping-progress-md",
            "title": "International shipping", "updatedAt": "2026-10-30T18:02:00.000Z",
            "done": 5, "total": 5, "totalFrom": "document", "gone": false,
            "ledger": "/home/op/shop/.superpowers/sdd/shipping/progress.md",
            "project": "/home/op/shop", "doc": "docs/plans/shipping.md",
            "task": "folder:/home/op/shop/launch/tasks/t5", "taskRef": "launch#t5", "edge": "document",
            "state": "done", "updatedBy": "kernel"
          }
        ]
      }
    },
    "views": [
      {
        "id": "executions",
        "archetype": "list",
        "kind": "execution",
        "columns": ["identity", "state", "at"],
        "facets": ["agent", "state"],
        "fold": { "when": "state in [done, stopped] and at < now - 7d" }
      }
    ],
    "actions": [{ "verb": "open" }]
  }
}
